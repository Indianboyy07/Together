# Not read by the current demo build. Needed once the app is wired to Supabase.
# Both values are safe to expose to the browser (the anon key is public by design; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# NEVER put the service_role key in this project or in Vercel browser-exposed variables.
